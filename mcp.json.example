{
  "mcpServers": {
    "meta-ads": {
      "command": "uvx",
      "args": ["meta-ads-manager-mcp"],
      "env": {
        "META_ACCESS_TOKEN": "YOUR_LONG_LIVED_GRAPH_API_TOKEN",
        "META_AD_ACCOUNT_ID": "YOUR_NUMERIC_AD_ACCOUNT_ID",
        "META_PAGE_ID": "YOUR_NUMERIC_PAGE_ID"
      }
    }
  }
}
